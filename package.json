{
  "name": "mathis-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm i18n:build && pnpm --filter web dev",
    "build": "turbo build && node scripts/prepare-pages.mjs",
    "i18n:build": "pnpm --filter @workspace/i18n build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write web packages scripts docs .github *.json *.yaml *.md *.ts *.js",
    "format:check": "prettier --check web packages scripts docs .github *.json *.yaml *.md *.ts *.js",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:html": "node scripts/check-html.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tanstack/eslint-config": "0.3.2",
    "eslint": "9.36.0",
    "lighthouse": "13.5.0",
    "prettier": "3.8.3",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "vnu-jar": "26.10.12"
  }
}
